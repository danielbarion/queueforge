#!/usr/bin/env php
<?php
declare(strict_types=1);

require dirname(__DIR__) . '/src/Routing.php';
require dirname(__DIR__) . '/src/Features.php';
require dirname(__DIR__) . '/src/Policy.php';
require dirname(__DIR__) . '/src/Codec.php';
require dirname(__DIR__) . '/src/Auth.php';
require dirname(__DIR__) . '/src/Store.php';
require dirname(__DIR__) . '/src/Cluster.php';
require dirname(__DIR__) . '/src/Discovery.php';
require dirname(__DIR__) . '/src/Broker.php';
require dirname(__DIR__) . '/src/Http.php';
require dirname(__DIR__) . '/src/Protocols.php';
require dirname(__DIR__) . '/src/Amqp10.php';
require dirname(__DIR__) . '/src/Extras.php';
require dirname(__DIR__) . '/src/Server.php';
require dirname(__DIR__) . '/src/Cores.php';
require dirname(__DIR__) . '/src/Handoff.php';
require dirname(__DIR__) . '/src/Supervise.php';

$args = array_slice($argv, 1);
$configPath = '';
$dev = false;
for ($i = 0; $i < count($args); $i++) {
    if ($args[$i] === '--config') {
        $configPath = $args[++$i] ?? '';
    }
    if ($args[$i] === '--dev-bootstrap') {
        $dev = true;
    }
}
if ($configPath === '' || !is_file($configPath)) {
    fwrite(STDERR, "usage: queueforge --config <file> [--dev-bootstrap]\n");
    exit(2);
}

$cfg = [
    'amqp' => '127.0.0.1:5675',
    'amqps' => '',
    'ca' => '',
    'auth' => [],
    'dir' => './data',
    'fsync_ms' => 10,
    'management' => '',
    'metrics' => '',
    'mqtt' => '',
    'stomp' => '',
    'stream' => '',
    'cluster' => '',
    'node_id' => 'queueforge',
    'node_id_explicit' => false,
    'members' => [],
    'tls' => false,
    'cert' => '',
    'key' => '',
];
$section = '';
$raw = (string) file_get_contents($configPath);
foreach (file($configPath, FILE_IGNORE_NEW_LINES) as $line) {
    $line = trim($line);
    if ($line === '' || str_starts_with($line, '#')) {
        continue;
    }
    if (preg_match('/^\[(.+)\]$/', $line, $m) === 1) {
        $section = $m[1];
        continue;
    }
    if (!str_contains($line, '=')) {
        continue;
    }
    [$key, $value] = array_map(trim(...), explode('=', $line, 2));
    $value = trim($value, "\"'");
    if ($section === 'listeners' && isset($cfg[$key]) && is_string($cfg[$key])) {
        $cfg[$key] = $value;
    }
    if ($section === 'data' && $key === 'dir') {
        $cfg['dir'] = $value;
    }
    if ($section === 'data' && $key === 'fsync_interval_ms') {
        $cfg['fsync_ms'] = max(1, (int) $value);
    }
    if ($section === 'cluster' && $key === 'node_id') {
        $cfg['node_id'] = $value; $cfg['node_id_explicit'] = true;
    }
    if ($section === 'cluster' && $key === 'listen') {
        $cfg['cluster'] = $value;
    }
    if ($section === 'cluster' && in_array($key, ['discovery','dns_name','dns_port'], true)) $cfg[$key] = $key === 'dns_port' ? (int)$value : $value;
    if ($section === 'tls' && $key === 'enabled') {
        $cfg['tls'] = $value === 'true';
    }
    if ($section === 'tls' && $key === 'cert_path') {
        $cfg['cert'] = $value;
    }
    if ($section === 'tls' && $key === 'ca_path') $cfg['ca']=$value;
    if (str_starts_with($section,'auth.')) $cfg['auth'][substr($section,5)][$key]=$value;
    if ($section === 'tls' && $key === 'key_path') {
        $cfg['key'] = $value;
    }
}

// The member list is an array of inline tables that spans several lines, so
// it is matched against the whole file rather than line by line. Either key
// order is accepted, as is the one-per-line spelling.
if (preg_match('/^\[cluster\](.*?)(?=^\[|\z)/ms', $raw, $block) === 1) {
    $text = (string) $block[1];
    if (preg_match('/members\s*=\s*\[(.*?)\]/s', $text, $list) === 1) {
        preg_match_all('/\{([^}]*)\}/', (string) $list[1], $rows);
        foreach ($rows[1] as $row) {
            $id = preg_match('/id\s*=\s*"([^"]+)"/', $row, $a) === 1 ? $a[1] : '';
            $addr = preg_match('/addr\s*=\s*"([^"]+)"/', $row, $b) === 1 ? $b[1] : '';
            if ($id !== '' && $addr !== '') {
                $cfg['members'][] = ['id' => $id, 'addr' => $addr];
            }
        }
    }
    if ($cfg['members'] === []) {
        preg_match_all('/^\s*id\s*=\s*"([^"]+)"\s*$\s*^\s*addr\s*=\s*"([^"]+)"\s*$/m', $text, $pairs, PREG_SET_ORDER);
        foreach ($pairs as $pair) {
            $cfg['members'][] = ['id' => $pair[1], 'addr' => $pair[2]];
        }
    }
}

if (getenv('QUEUEFORGE_DATA_DIR')) {
    $cfg['dir'] = (string) getenv('QUEUEFORGE_DATA_DIR');
}
if (getenv('QUEUEFORGE_NODE_ID')) {
    $cfg['node_id'] = (string) getenv('QUEUEFORGE_NODE_ID'); $cfg['node_id_explicit'] = true;
}
if (getenv('QUEUEFORGE_CLUSTER')) {
    $cfg['cluster'] = (string) getenv('QUEUEFORGE_CLUSTER');
}
if (getenv('QUEUEFORGE_MEMBERS')) {
    $parsed = json_decode((string) getenv('QUEUEFORGE_MEMBERS'), true);
    if (is_array($parsed)) {
        $cfg['members'] = $parsed;
    }
}
if (($cfg['discovery'] ?? '') === 'dns' && !$cfg['node_id_explicit']) $cfg['node_id'] = '';
if (getenv('QUEUEFORGE_CHILD') !== '1') {
    try { $cfg = Discovery::resolve($cfg); } catch (RuntimeException $error) { fwrite(STDERR, $error->getMessage()."\n"); exit(2); }
}
if (getenv('QUEUEFORGE_BIND_MGMT') === '0') {
    $cfg['management'] = '';
}
if (getenv('QUEUEFORGE_CHILD') !== '1' && Cores::granted() > 1 && !$cfg['tls'] && $cfg['amqps'] === '') {
    Supervise::run(__FILE__, $configPath, $dev, $cfg);
    exit(0);
}

$dir = $cfg['dir'];
if (!str_starts_with($dir, '/')) {
    $dir = dirname($configPath) . '/' . $dir;
}
$cfg['dir']=$dir;
$cfg['fresh']=!is_file($dir.'/messages.log')&&!is_file($dir.'/users.json')&&!is_file($dir.'/topology.json');
$store = new Store($dir . '/messages.log');
$broker = new Broker($store, $dir . '/users.json');
$broker->authConfig=$cfg['auth'];
if ($dev) {
    $broker->bootstrap('devpassword12');
}

$addr = $cfg['amqp'];
$context = stream_context_create([]);
$scheme = 'tcp';
if ($cfg['tls'] && $cfg['cert'] !== '' && $cfg['key'] !== '') {
    $scheme = 'tcp';
    $context = stream_context_create(['ssl' => [
        'crypto_method' => STREAM_CRYPTO_METHOD_TLS_SERVER,
        'queueforge_tls' => true,
        'capture_peer_cert_chain' => true,
        'local_cert' => $cfg['cert'],
        'local_pk' => $cfg['key'],
        'cafile' => $cfg['ca'] !== '' ? $cfg['ca'] : null,
        'verify_peer' => $cfg['ca'] !== '',
        // Server-side client verification checks the chain, not a client DNS name.
        'verify_peer_name' => false,
        'allow_self_signed' => false,
        'capture_peer_cert' => true,
    ]]);
}
$listen = null;
if (getenv('QUEUEFORGE_CHILD') !== '1') {
    $listen = stream_socket_server("$scheme://$addr", $errno, $errstr, STREAM_SERVER_BIND | STREAM_SERVER_LISTEN, $context);
    if ($listen === false) {
        fwrite(STDERR, "listen $addr: $errstr\n");
        exit(1);
    }
    stream_set_blocking($listen, false);
}
$extras = new Extras($broker, $cfg);
$handoff = null;
$down = getenv('QUEUEFORGE_HANDOFF_DOWN');
$up = getenv('QUEUEFORGE_HANDOFF_UP');
if (is_string($down) && $down !== '' && is_string($up) && $up !== '') {
    $handoff = Handoff::bind($down);
    $handoff->peer = $up;
}
$who = (string) ($cfg['node_id'] ?? 'solo');
fwrite(STDOUT, "queueforge-php amqp=" . ($listen === null ? 'adopted' : $addr) . " node=$who fsync_ms={$cfg['fsync_ms']}\n");
(new Server($listen, $broker, $cfg['fsync_ms'], $extras, $handoff))->run();
